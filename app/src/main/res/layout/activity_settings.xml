<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgPrimary"
    android:orientation="vertical">

    <!-- Toolbar -->
    <io.agents.arya.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp" />

    <!-- 滚动内容 -->
    <EditText
        android:id="@+id/settingsSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:hint="@string/settings_search_hint"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_edit_text" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!-- 权限分组 -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/permissionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- 模型分组 -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/modelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Appearance -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/appearanceGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Tools -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/toolsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Remote Control -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/remoteGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- About -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/aboutGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 通道分组 (hidden) -->
            <io.agents.arya.widget.MenuGroup
                android:id="@+id/channelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
